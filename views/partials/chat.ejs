<!-- Widget chatbot pelanggan (Asisten AI). Dipasang di views/index.ejs sebelum footer. -->
<style>
#cb-btn{position:fixed;right:18px;bottom:18px;z-index:8;box-shadow:4px 4px 0 var(--ink);border:2px solid var(--ink);background:var(--kunyit);color:var(--ink)}
#cb{position:fixed;right:18px;bottom:18px;z-index:8;width:min(380px,92vw);height:min(560px,80vh);display:flex;flex-direction:column;background:#fff;border:2px solid var(--ink);border-radius:20px;box-shadow:6px 6px 0 var(--ink);overflow:hidden}
#cb[hidden]{display:none}
#cb header{display:flex;align-items:center;gap:8px;padding:12px 14px;background:var(--ink);color:#fff}
#cb header strong{font-family:"Bricolage Grotesque",sans-serif;font-size:18px;color:var(--kunyit)}
#cb-st{flex:1;font-size:12px;opacity:.85}
#cb-x{padding:2px 10px;background:transparent;color:#fff;font-size:20px}
#cb-log{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;background:var(--bg)}
.cb-m{max-width:85%;padding:8px 12px;border-radius:14px;font-size:14.5px;white-space:pre-wrap;word-wrap:break-word}
.cb-m small{display:block;font-size:11px;font-weight:700;opacity:.65;margin-bottom:2px}
.cb-pelanggan{align-self:flex-end;background:var(--kunyit)}
.cb-ai{align-self:flex-start;background:#fff;border:1px solid var(--line)}
.cb-admin{align-self:flex-start;background:var(--daun);color:#fff}
.cb-sistem{align-self:center;font-size:12px;color:#46604d;text-align:center}
#cb-chips{display:flex;flex-wrap:wrap;gap:6px;padding:0 12px 8px;background:var(--bg)}
#cb-chips button{padding:5px 12px;font-size:13px}
#cb-form{display:flex;gap:8px;padding:10px;border-top:2px solid var(--ink)}
#cb-form input{flex:1;min-width:0}
</style>
<button id="cb-btn" type="button">Tanya jamu</button>
<section id="cb" hidden aria-label="Chat asisten Jamuku">
  <header><strong>Asisten Jamuku</strong><span id="cb-st"></span><button id="cb-x" type="button" aria-label="Tutup chat">×</button></header>
  <div id="cb-log" role="log" aria-live="polite"></div>
  <div id="cb-chips"></div>
  <form id="cb-form"><input id="cb-in" maxlength="500" autocomplete="off" required placeholder="Tulis keluhanmu, mis. sakit kepala"><button>Kirim</button></form>
</section>
<script>
(function () {
  const q = s => document.querySelector(s);
  const e = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const LABEL = { pelanggan: 'Kamu', ai: 'Asisten AI', admin: 'Admin' };
  const STATUS = { ai: 'Dijawab asisten AI', menunggu_admin: 'Menunggu admin', admin: 'Terhubung dengan admin', selesai: 'Percakapan selesai' };
  const SAPA = 'Halo! Ceritakan keluhanmu, nanti kurekomendasikan jamu dari katalog kami. Jamu bukan pengganti obat ya.';
  let id = localStorage.getItem('chatId') || '', timer = null, kirimBerjalan = false, jumlah = -1;

  function gambar(d) {
    const msgs = d ? d.messages : [];
    q('#cb-st').textContent = d ? (STATUS[d.mode] || '') : 'Dijawab asisten AI';
    q('#cb-chips').style.display = msgs.length ? 'none' : 'flex';
    let h = `<div class="cb-m cb-ai"><small>Asisten AI</small>${e(SAPA)}</div>`;
    h += msgs.map(m => m.role === 'sistem' ? `<div class="cb-m cb-sistem">${e(m.teks)}</div>` : `<div class="cb-m cb-${m.role}"><small>${LABEL[m.role]}</small>${e(m.teks)}</div>`).join('');
    if (kirimBerjalan) h += '<div class="cb-m cb-sistem">Asisten sedang mengetik…</div>';
    else if (d && d.mode === 'menunggu_admin') h += '<div class="cb-m cb-sistem">Pesanmu sudah diteruskan ke admin. Balasan akan muncul di sini.</div>';
    const log = q('#cb-log'); log.innerHTML = h;
    if (msgs.length !== jumlah || kirimBerjalan) { log.scrollTop = log.scrollHeight; jumlah = msgs.length; }
  }
  async function muat() {
    if (!id || kirimBerjalan) return;
    try {
      const r = await fetch('/api/chat/' + id);
      if (r.status === 404) { localStorage.removeItem('chatId'); id = ''; return gambar(null); }
      gambar(await r.json());
    } catch { /* abaikan, coba lagi pada polling berikutnya */ }
  }
  async function kirim(teks) {
    if (kirimBerjalan) return;
    kirimBerjalan = true;
    const log = q('#cb-log');
    log.insertAdjacentHTML('beforeend', `<div class="cb-m cb-pelanggan"><small>Kamu</small>${e(teks)}</div><div class="cb-m cb-sistem">Asisten sedang mengetik…</div>`);
    log.scrollTop = log.scrollHeight;
    try {
      const r = await fetch('/api/chat', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conversationId: id, pesan: teks }) });
      const d = await r.json();
      if (!r.ok) throw new Error(d.pesan || 'Gagal mengirim');
      id = d.id; localStorage.setItem('chatId', id); kirimBerjalan = false; gambar(d);
    } catch (err) {
      kirimBerjalan = false; await muat();
      log.insertAdjacentHTML('beforeend', `<div class="cb-m cb-sistem">${e(err.message)}</div>`);
    }
  }
  function buka() {
    q('#cb').hidden = false; q('#cb-btn').hidden = true; q('#cb-in').focus();
    id ? muat() : gambar(null);
    timer = setInterval(muat, 4000);
  }
  q('#cb-chips').innerHTML = ['Sakit kepala', 'Pegal linu', 'Datang bulan', 'Batuk/flu'].map(k => `<button type="button" class="ghost" data-k="${k}">${k}</button>`).join('');
  q('#cb-chips').addEventListener('click', ev => { const b = ev.target.closest('[data-k]'); if (b) kirim('Jamu apa untuk ' + b.dataset.k.toLowerCase() + '?'); });
  q('#cb-btn').addEventListener('click', buka);
  q('#cb-x').addEventListener('click', () => { q('#cb').hidden = true; q('#cb-btn').hidden = false; clearInterval(timer); });
  q('#cb-form').addEventListener('submit', ev => { ev.preventDefault(); const i = q('#cb-in'), t = i.value.trim(); if (!t) return; i.value = ''; kirim(t); });
})();
</script>
