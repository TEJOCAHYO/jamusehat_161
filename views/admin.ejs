<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin - Jamuku</title>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#12281a;--daun:#1f5a36;--kunyit:#f5b700;--tint:#e1eedb;--bg:#f2f7ee;--jahe:#c0432a;--line:#c9dabf}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 "Nunito Sans",system-ui,sans-serif;height:100vh;display:flex;flex-direction:column}
    h1{font:800 24px "Bricolage Grotesque",sans-serif;margin:0;color:var(--kunyit)}
    .top{display:flex;gap:16px;align-items:center;flex-wrap:wrap;background:var(--ink);padding:12px 20px;color:#fff}
    .top a{color:#e8f2e2;text-decoration:none;font-size:14px}
    #stat{display:flex;gap:8px;flex:1;flex-wrap:wrap}
    #stat span{background:rgba(255,255,255,.12);padding:3px 12px;border-radius:99px;font-size:13px;font-weight:700}
    #stat span.warn{background:var(--kunyit);color:var(--ink)}
    .wrap{flex:1;display:grid;grid-template-columns:340px 1fr;min-height:0}
    aside{border-right:2px solid var(--ink);background:#fff;display:flex;flex-direction:column;min-height:0}
    .tabs{display:flex;flex-wrap:wrap;gap:6px;padding:10px;border-bottom:1px solid var(--line)}
    button{font:inherit;font-weight:700;border:0;border-radius:99px;padding:8px 16px;cursor:pointer;background:var(--daun);color:#fff}
    button.g{background:var(--tint);color:var(--ink)}
    .tabs button{padding:4px 12px;font-size:13px;background:var(--tint);color:var(--ink)}
    .tabs button.on{background:var(--ink);color:var(--kunyit)}
    #list{list-style:none;margin:0;padding:0;overflow-y:auto;flex:1}
    #list li{position:relative;padding:12px 14px;border-bottom:1px solid var(--line);cursor:pointer}
    #list li:hover{background:var(--bg)} #list li.on{background:var(--tint)}
    #list .top2{display:flex;justify-content:space-between;gap:8px}
    #list .pv{color:#46604d;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px}
    #list .kosong{cursor:default;color:#46604d;text-align:center}
    .m{font-size:11px;font-weight:800;padding:1px 10px;border-radius:99px;background:var(--tint)}
    .m.menunggu_admin{background:var(--kunyit)} .m.admin{background:var(--daun);color:#fff} .m.selesai{background:#ddd}
    .ub{position:absolute;right:12px;bottom:10px;background:var(--jahe);color:#fff;border-radius:99px;font-size:12px;padding:0 8px}
    #room{display:flex;flex-direction:column;min-height:0;padding:0}
    #room .kosong{margin:auto;color:#46604d}
    #hdr{padding:12px 18px;border-bottom:1px solid var(--line);background:#fff;display:flex;gap:10px;align-items:center}
    #hdr strong{font:800 18px "Bricolage Grotesque",sans-serif}
    #sum{margin:10px 18px 0;padding:8px 12px;background:#fff6d6;border:2px solid var(--kunyit);border-radius:12px;font-size:14px}
    #sum:empty{display:none}
    #log{flex:1;overflow-y:auto;padding:14px 18px;display:flex;flex-direction:column;gap:8px}
    .b{max-width:70%;padding:8px 12px;border-radius:14px;white-space:pre-wrap;word-wrap:break-word}
    .b small{display:block;font-size:11px;font-weight:800;opacity:.65}
    .b.pelanggan{align-self:flex-start;background:var(--kunyit)}
    .b.ai{align-self:flex-end;background:#fff;border:1px solid var(--line)}
    .b.admin{align-self:flex-end;background:var(--daun);color:#fff}
    .b.sistem{align-self:center;background:none;font-size:12px;color:#46604d;max-width:90%}
    #f{padding:12px 18px;border-top:2px solid var(--ink);background:#fff}
    #f textarea{width:100%;font:inherit;padding:10px;border:1px solid var(--line);border-radius:10px;resize:vertical}
    .acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    @media(max-width:760px){.wrap{grid-template-columns:1fr}aside{max-height:40vh;border-right:0;border-bottom:2px solid var(--ink)}}
  </style>
</head>
<body>
  <div class="top"><h1>Admin Jamuku</h1><div id="stat"></div><a href="/">← Kembali ke toko</a></div>
  <div class="wrap">
    <aside>
      <div class="tabs" id="tabs">
        <button class="on" data-f="semua">Semua</button><button data-f="menunggu_admin">Perlu admin</button>
        <button data-f="ai">AI</button><button data-f="admin">Admin</button><button data-f="selesai">Selesai</button>
      </div>
      <ul id="list"></ul>
    </aside>
    <main id="room"><div class="kosong">Pilih percakapan di sebelah kiri.</div></main>
  </div>
<script>
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const MODE = { ai: 'AI menjawab', menunggu_admin: 'Perlu admin', admin: 'Ditangani admin', selesai: 'Selesai' };
const ROLE = { pelanggan: 'Pelanggan', ai: 'Asisten AI', admin: 'Admin', sistem: 'Sistem' };
const S = { sel: null, filter: 'semua', list: [] };
const api = async (u, o = {}) => {
  const r = await fetch('/admin/api' + u, { method: o.method || 'GET', headers: { 'Content-Type': 'application/json' }, body: o.body ? JSON.stringify(o.body) : undefined });
  const d = await r.json(); if (!r.ok) throw new Error(d.pesan || 'Gagal'); return d;
};
function statistik() {
  const n = m => S.list.filter(x => x.mode === m).length;
  $('#stat').innerHTML = `<span>${S.list.length} percakapan</span><span class="${n('menunggu_admin') ? 'warn' : ''}">${n('menunggu_admin')} perlu admin</span><span>${n('ai')} dijawab AI</span><span>${n('admin')} ditangani admin</span><span>${n('selesai')} selesai</span>`;
}
function gambarDaftar() {
  const L = S.list.filter(x => S.filter === 'semua' || x.mode === S.filter);
  $('#list').innerHTML = L.length ? L.map(x => `<li class="${x.id === S.sel ? 'on' : ''}" data-id="${x.id}">
    <div class="top2"><strong>${esc(x.nama)}</strong><span class="m ${x.mode}">${MODE[x.mode]}</span></div>
    <div class="pv">${x.pesanTerakhir ? esc(ROLE[x.pesanTerakhir.role] + ': ' + x.pesanTerakhir.teks) : ''}</div>${x.unread ? `<span class="ub">${x.unread}</span>` : ''}</li>`).join('') : '<li class="kosong">Belum ada percakapan</li>';
}
async function daftar() { S.list = await api('/percakapan'); statistik(); gambarDaftar(); }
async function muat() {
  if (!S.sel) return;
  const d = await api('/percakapan/' + S.sel);
  $('#hdr').innerHTML = `<strong>${esc(d.nama)}</strong><span class="m ${d.mode}">${MODE[d.mode]}</span>`;
  $('#sum').innerHTML = d.ringkasan ? `<b>Ringkasan AI untuk admin:</b> ${esc(d.ringkasan)}` : '';
  const log = $('#log'), bawah = log.scrollHeight - log.scrollTop - log.clientHeight < 60;
  log.innerHTML = d.messages.map(m => `<div class="b ${m.role}"><small>${ROLE[m.role]} · ${new Date(m.waktu).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' })}</small>${esc(m.teks)}</div>`).join('');
  if (bawah) log.scrollTop = log.scrollHeight;
}
function pilih(id) {
  S.sel = id;
  $('#room').innerHTML = `<div id="hdr"></div><div id="sum"></div><div id="log"></div>
    <form id="f"><textarea id="t" rows="2" maxlength="1000" placeholder="Balas pelanggan sebagai admin… (Enter untuk kirim)" required></textarea>
    <div class="acts"><button>Kirim sebagai admin</button><button type="button" class="g" data-m="ai">Kembalikan ke AI</button><button type="button" class="g" data-m="selesai">Tandai selesai</button></div></form>`;
  $('#t').addEventListener('keydown', ev => { if (ev.key === 'Enter' && !ev.shiftKey) { ev.preventDefault(); $('#f').requestSubmit(); } });
  $('#f').addEventListener('submit', async ev => {
    ev.preventDefault(); const t = $('#t').value.trim(); if (!t) return;
    try { await api(`/percakapan/${S.sel}/balas`, { method: 'POST', body: { teks: t } }); $('#t').value = ''; await muat(); const l = $('#log'); l.scrollTop = l.scrollHeight; daftar(); } catch (e) { alert(e.message); }
  });
  $('#f').addEventListener('click', async ev => {
    const b = ev.target.closest('[data-m]'); if (!b) return;
    try { await api(`/percakapan/${S.sel}/mode`, { method: 'PATCH', body: { mode: b.dataset.m } }); await muat(); daftar(); } catch (e) { alert(e.message); }
  });
  muat().then(() => { const l = $('#log'); l.scrollTop = l.scrollHeight; daftar(); });
}
$('#list').addEventListener('click', ev => { const li = ev.target.closest('li[data-id]'); if (li) pilih(li.dataset.id); });
$('#tabs').addEventListener('click', ev => { const b = ev.target.closest('[data-f]'); if (!b) return; S.filter = b.dataset.f; document.querySelectorAll('#tabs button').forEach(x => x.classList.toggle('on', x === b)); gambarDaftar(); });
daftar().catch(e => $('#list').innerHTML = `<li class="kosong">${esc(e.message)}</li>`);
setInterval(() => { daftar().catch(() => {}); muat().catch(() => {}); }, 4000);
</script>
</body>
</html>
